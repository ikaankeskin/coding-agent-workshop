# Copy this file to .env and fill in the keys you have.
# .env is gitignored. Do not commit real keys.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional. OpenJev is the decision server, not the model that writes text.
OPENJEV_API_KEY=
OPENJEV_BASE_URL=http://127.0.0.1:8791/v1/systemone
OPENJEV_MODEL=open-jev

# Optional. A catalog id from .agent/settings.json. Pins the main conversation.
# AGENT_MODEL=sonnet
# AGENT_CONTEXT_LIMIT=100000
# AGENT_MAX_TURNS=12

# Optional. When set, sub-agents are checked by a local OpenAPPA runtime.
# APPA_RUNTIME_URL=http://127.0.0.1:8787
